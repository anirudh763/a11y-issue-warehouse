# Optional local extraction/test tools; the static explorer has no runtime env loader.
# GITHUB_TOKEN=replace-with-a-private-local-token
# WAREHOUSE_DB=/absolute/path/to/data/warehouse.db

# Python web runtime; private persistent volume outside docs/.
APP_DATA_DIR=/var/lib/product
APP_PUBLIC_ORIGIN=http://127.0.0.1:3005
APP_LOCAL_HTTP=1
# Generate a stable random secret outside Git; required for server persistence.
APP_SESSION_SECRET=
APP_SESSION_TTL_SECONDS=2592000
APP_PASSWORD_AUTH=1
# HTTPS: set an exact https:// origin and APP_LOCAL_HTTP=0.
